{
  "name": "dsh-harness-orb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chime and system notification when a turn finishes or DSH is waiting for you.",
  "author": "ST0new",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "reminder",
    "attention"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
